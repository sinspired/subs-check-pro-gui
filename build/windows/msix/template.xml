<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="subs-check-pro-gui.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Sinspired\subs-check-pro-gui">
    </Installer>
    <PackageInformation
        PackageName="Subs-Check-Pro-GUI"
        PackageDisplayName="Subs-Check-Pro-GUI"
        PublisherName="CN=Sinspired"
        PublisherDisplayName="Sinspired"
        Version="0.1.0.0"
        PackageDescription="A Performance Proxy Chcker and sub store">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.example.subs-check-pro-gui"
                Description="A Performance Proxy Chcker and sub store"
                DisplayName="Subs-Check-Pro-GUI"
                ExecutableName="subs-check-pro-gui.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Subs-Check-Pro-GUI</DisplayName>
            <PublisherDisplayName>Sinspired</PublisherDisplayName>
            <Description>A Performance Proxy Chcker and sub store</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="subs-check-pro-gui.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
